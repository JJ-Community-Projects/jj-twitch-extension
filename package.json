{
  "name": "jj-twitch-extension",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "gen-env": "node genEnv.js",
    "start": "astro dev",
    "publish": "npm run build && npm run after && npm run zip",
    "build": "npm run delete-dist && astro check && astro build",
    "delete-dist": "zsh ./delete_dist.sh",
    "after": "node after.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "zip": "zsh ./zip_dist.sh",
    "firebase": "npm run publish && firebase deploy --only hosting"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/solid-js": "^4.4.2",
    "@astrojs/tailwind": "^5.1.2",
    "@kobalte/core": "^0.13.7",
    "@kobalte/tailwindcss": "^0.7.0",
    "@solid-primitives/storage": "^4.3.3",
    "@tanstack/solid-query": "^5.90.6",
    "@tanstack/solid-query-devtools": "^5.90.4",
    "astro": "5.14.3",
    "luxon": "^3.5.0",
    "node-html-parser": "^6.1.12",
    "solid-color": "^0.0.4",
    "solid-i18n": "^1.1.0",
    "solid-icons": "^1.1.0",
    "solid-js": "1.9.4",
    "solid-qr-code": "^0.1.11",
    "solid-transition-group": "^0.2.3",
    "tailwind-merge": "^2.3.0",
    "tailwind-scrollbar": "^3.1.0",
    "tailwindcss": "^3.4.14",
    "tmi.js": "^1.8.5",
    "typescript": "^5.6.3"
  },
  "devDependencies": {
    "@types/luxon": "^3.4.2",
    "@types/tmi.js": "^1.8.6",
    "@types/twitch-ext": "^1.24.9",
    "fluid-tailwind": "^1.0.3",
    "tiny-glob": "^0.2.9"
  }
}
