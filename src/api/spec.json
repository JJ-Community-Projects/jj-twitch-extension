    "/twitch-extension/user-data/{channelId}": {
      "get": {
        "operationId": "getUserData",
        "summary": "Get the users data",
        "description": "Get the use data",
        "tags": [
          "twitch-extension"
        ],
        "parameters": [
          {
            "name": "channelId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "userId",
            "in": "query",
