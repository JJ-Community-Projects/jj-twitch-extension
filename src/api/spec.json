              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OverviewSchema"
                }
              }
            }
          }
        }
      }
    },
    "/twitch-extension/yogs-schedule": {
      "get": {
        "operationId": "getYogsSchedule",
        "summary": "Get the yogs schedule",
        "description": "Get the yogs schedule",
        "tags": [
          "twitch-extension"
        ],
        "parameters": [
          {
            "name": "channelId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "allowEmptyValue": true,
            "allowReserved": true
          },
          {
            "name": "userId",
            "in": "query",
